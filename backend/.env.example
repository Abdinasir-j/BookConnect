# Copy this file to .env
PORT=3000

# XAMPP MySQL defaults: user "root", empty password, port 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bookconnect

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Browser origins allowed to call the API directly (Apache proxy needs none)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
DELIVERY_FEE=300

# M-Pesa (Safaricom Daraja). Keep "simulate" for demos.
MPESA_MODE=simulate
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-url/api/payments/mpesa/callback
